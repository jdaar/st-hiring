{
  "name": "st-hiring",
  "private": true,
  "packageManager": "yarn@4.18.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "coverage": "vitest run --coverage",
    "sonar": "yarn coverage && sonar-scanner",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,mjs,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,mjs,css}\""
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "prettier": "3.3.2",
    "turbo": "^2.11.7",
    "vitest": "^2.1.9"
  }
}
